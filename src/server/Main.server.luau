local CollisionGroups = require(script.Parent.CollisionGroups)
local TownBuilder = require(script.Parent.TownBuilder)
local TrafficLights = require(script.Parent.TrafficLights)
local SpeedSigns = require(script.Parent.SpeedSigns)
local School = require(script.Parent.School)
local CrosswalkBuilder = require(script.Parent.CrosswalkBuilder)
local Pedestrians = require(script.Parent.Pedestrians)
local CarSpawner = require(script.Parent.CarSpawner)
local Rules = require(script.Parent.Rules)

CollisionGroups.setup()
local town = TownBuilder.build()
TrafficLights.build(town)
TrafficLights.start()
SpeedSigns.build(town)
School.build(town)
CrosswalkBuilder.build(town)
Pedestrians.build(town)
Pedestrians.start()
CarSpawner.start()
Rules.start(function()
	return { crosswalks = Pedestrians.status() }
end)
